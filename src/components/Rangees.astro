---
import Img from './Img.astro';

const { titre = 'Un engagement pour tous' } = Astro.props;

const RANGEES = [
  {
    etiquette: 'Compétition · FFBoxe', nom: 'Boxe\nAmateur',
    texte: 'La Boxe Amateur au Noble Art Portésien allie excellence sportive et développement personnel, offrant soutien et outils pour se surpasser.',
    href: '/boxe-amateur-toulouse-formation-competitive/', image: 'boxe-anglaise-amateur-toulouse.webp',
    alt: 'Boxeurs amateurs à l’entraînement au Noble Art Portésien',
  },
  {
    etiquette: 'Sans pression · Tous niveaux', nom: 'Boxe\nLoisir',
    texte: 'Notre programme de Boxe Loisir à Noble Art Portésien permet de découvrir la boxe sans compétition, dans une ambiance conviviale.',
    href: '/boxe-loisir-toulouse-detente-sportive/', image: 'boxe-anglaise-loisir-toulouse.webp',
    alt: 'Séance de boxe loisir dans une ambiance conviviale au Noble Art Portésien',
  },
  {
    etiquette: 'Jusqu’à 18 ans', nom: 'Boxe\nÉducative',
    texte: 'Découvrez la Boxe Éducative : chaque coup enseigne discipline, confiance et respect, transformant l’énergie des jeunes en excellence.',
    href: '/boxe-educative-jeunes-toulouse/', image: 'boxe-anglaise-educative-toulouse.webp',
    alt: 'Jeunes boxeurs en cours de boxe éducative au Noble Art Portésien',
  },
  {
    etiquette: 'Handi-boxe · Insertion', nom: 'Boxe\nInsertion',
    texte: 'Au Noble Art Portésien, nous utilisons la boxe comme vecteur d’intégration, offrant des programmes accessibles à tous pour promouvoir l’inclusion.',
    href: '/pole-insertion-inclusion-boxe-toulouse/', image: 'pole-boxe-inclusion-insertion-toulouse.webp',
    alt: 'Le pôle insertion et inclusion du Noble Art Portésien',
  },
];
const spreads = [RANGEES.slice(0, 2), RANGEES.slice(2, 4)];
---

<section class="rangees" id="activites" aria-label="Les activités du club">
  <header class="rangees__entete">
    <p class="micro micro--or">Noble Art Portésien · Portet-sur-Garonne</p>
    <h2>{titre}</h2>
  </header>
  {spreads.map((spread, spreadIndex) => (
    <div class:list={['double-page', `double-page--${spreadIndex + 1}`]} data-revele>
      {spread.map((r, itemIndex) => {
        const numero = spreadIndex * 2 + itemIndex + 1;
        return (
          <article class:list={['duo', `duo--${numero}`]}>
            <div class="duo__photo">
              <Img src={r.image} alt={r.alt} width="1440" height="900" sizes="(max-width: 899px) 100vw, 60vw" />
            </div>
            <span class="duo__chiffre tabulaire" aria-hidden="true">{String(numero).padStart(2, '0')}</span>
            <div class="duo__bloc">
              <p class="etiquette">{r.etiquette}</p>
              <h2 class="duo__nom">
                <a href={r.href}>{r.nom.split('\n').map((l, k) => (k === 0 ? l : [<br />, l]))}</a>
              </h2>
              <p class="duo__texte">{r.texte}</p>
              <span class="fleche" aria-hidden="true">Découvrir</span>
            </div>
          </article>
        );
      })}
    </div>
  ))}
</section>

<style>
  .rangees { position: relative; display: grid; gap: 1px; background: var(--or); }
  .rangees__entete {
    position: absolute; z-index: 3; top: clamp(1.1rem, 2.8vw, 2.3rem); left: clamp(1.25rem, 4vw, 3.8rem);
    display: grid; gap: .35rem; max-width: min(38rem, calc(100% - 2.5rem));
    pointer-events: none;
  }
  .rangees__entete h2 {
    max-width: 11ch; font-size: clamp(2.1rem, 5.4vw, 5.2rem); line-height: .88;
    text-transform: uppercase; text-wrap: balance;
  }
  .double-page {
    display: grid; gap: 1px; min-height: min(84svh, 820px);
    background: rgba(255,128,36,.35);
  }
  @media (min-width: 900px) {
    .double-page--1 { grid-template-columns: 1.22fr .78fr; }
    .double-page--2 { grid-template-columns: .76fr 1.24fr; }
  }
  .duo {
    position: relative; isolation: isolate; min-width: 0; min-height: 560px;
    overflow: hidden; display: grid; align-items: end;
    background: var(--nuit);
  }
  .duo__photo { position: absolute; inset: 0; z-index: -2; }
  .duo__photo img {
    width: 100%; height: 100%; object-fit: cover;
    filter: contrast(1.06) saturate(1.02);
    transition: transform .9s var(--courbe), filter .6s;
  }
  .duo--2 .duo__photo img, .duo--3 .duo__photo img { object-position: 58% center; }
  .duo::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(20,20,20,.04) 22%, rgba(20,20,20,.88) 82%, rgba(20,20,20,.98)),
      linear-gradient(90deg, rgba(20,20,20,.62), transparent 64%);
  }
  .duo:hover .duo__photo img { transform: scale(1.025); filter: contrast(1.08) saturate(1.08); }
  .duo__chiffre {
    position: absolute; top: clamp(.7rem, 2vw, 1.4rem); right: clamp(.8rem, 2vw, 1.6rem);
    font-family: var(--f-affiche); font-size: clamp(5rem, 12vw, 10rem); line-height: .8;
    color: transparent; -webkit-text-stroke: 1px rgba(255,128,36,.7);
    pointer-events: none; user-select: none;
  }
  .duo--2 .duo__chiffre, .duo--3 .duo__chiffre { right: auto; left: clamp(.8rem, 2vw, 1.6rem); }
  .duo__bloc {
    width: min(100%, 38rem); padding: clamp(1.25rem, 3.4vw, 3rem);
    display: grid; gap: .62rem;
  }
  .duo--2 .duo__bloc, .duo--3 .duo__bloc { justify-self: end; }
  .duo__nom { font-size: clamp(2.7rem, 6.4vw, 5.8rem); line-height: .86; text-transform: uppercase; }
  .double-page .duo:nth-child(2) .duo__nom { font-size: clamp(2.4rem, 5vw, 4.5rem); }
  .duo__nom a { color: var(--craie); text-decoration: none; }
  .duo__nom a::after { content: ''; position: absolute; inset: 0; }
  .duo:hover .duo__nom a { color: var(--or); }
  .duo__texte { max-width: 46ch; font-size: var(--t-s); color: var(--craie-sourde); }
  .duo .fleche { margin-top: .2rem; }
  .duo:hover .fleche { color: var(--or); }
  .duo:hover .fleche::before { width: 3.4rem; }

  @media (max-width: 899px) {
    .rangees__entete {
      position: relative; inset: auto; max-width: none; padding: 1.6rem 1.25rem 1.8rem;
      background: var(--nuit);
    }
    .double-page { min-height: 0; }
    .duo { min-height: clamp(520px, 76svh, 680px); }
    .duo__bloc { padding: 1.25rem; }
    .duo__texte { font-size: var(--t-base); }
  }
  @media (prefers-reduced-motion: reduce) {
    .duo__photo img, .duo:hover .duo__photo img { transform: none; transition: none; }
  }
</style>
