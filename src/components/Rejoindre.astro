---
import Img from './Img.astro';
const { image = '/img/club-boxe-toulouse-portet.webp' } = Astro.props;
---

<section class="rejoindre" aria-labelledby="rejoindre-titre">
  <Img class="rejoindre__fond" src={image.replace("/img/", "")} alt="" aria-hidden="true"
       width="1280" height="659" sizes="100vw" />
  <div class="contenu rejoindre__corps">
    <h2 id="rejoindre-titre" data-revele>Rejoignez la communauté Noble&nbsp;Art&nbsp;Portésien</h2>
    <p class="chapeau" data-revele data-delai="1">
      Situé à Portet-sur-Garonne, notre club de boxe accueille novices et
      compétiteurs dans une ambiance chaleureuse et inclusive. Rejoignez-nous
      pour une expérience enrichissante, accessible à tous les âges et niveaux.
    </p>
    <div class="rejoindre__actions" data-revele data-delai="2">
      <a class="btn btn--or" href="/contactez-noble-art-portesien/"><span>J’adhère au club</span><svg class="btn__fleche" width="13" height="10" viewBox="0 0 13 10" aria-hidden="true" focusable="false"><path d="M8 1l4 4-4 4M12 5H0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <a class="btn btn--fantome" href="/#tarifs"><span>Voir les tarifs</span><svg class="btn__fleche" width="13" height="10" viewBox="0 0 13 10" aria-hidden="true" focusable="false"><path d="M8 1l4 4-4 4M12 5H0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
  </div>
</section>

<style>
  .rejoindre { position: relative; isolation: isolate; padding-block: clamp(4rem, 11vw, 8rem); overflow: hidden; }
  .rejoindre__fond {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%; object-fit: cover;
  }
  .rejoindre::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(105deg, var(--nuit) 18%, rgba(34, 34, 34, .82) 55%, rgba(34, 34, 34, .55) 100%);
  }
  .rejoindre__corps { display: grid; gap: var(--e3); max-width: var(--contenu); }
  .rejoindre__actions { display: flex; flex-wrap: wrap; gap: var(--e2); }
</style>
