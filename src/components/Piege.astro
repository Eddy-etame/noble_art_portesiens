---
import { VEDETTES } from '../data/club.js';

/* =====================================================================
   LE PIÈGE — version 3.

   V1 : un rectangle doré avec un prix et un talon. Ça ressemblait à une
   carte de prix, pas à un objet.

   Ce qui manquait pour qu'on y croie, et que porte tout document
   officiel : une bande d'en-tête, un GUILLOCHÉ (le fond moiré qu'on
   grave sur les licences et les billets pour qu'on ne les photocopie
   pas), le sigle de l'émetteur, un code-barres, et une inclinaison —
   un objet posé n'est jamais parfaitement droit.

   L'objet devient une carte d'accès à la salle partagée. L'émetteur et
   le vendeur externe sont nommés directement sur la carte afin qu'elle
   ne puisse pas être confondue avec une licence de l'association.

   V3 : la carte porte DEUX formules, l'étudiant puis l'adulte. Pas deux
   cartes côte à côte — deux coupons détachables sur la même carte, comme
   un carnet : chacun son prix, son talon et son lien, séparés par une
   ligne de perforation encochée sur les deux bords. Une seule carte reste
   un objet ; deux cartes redeviennent des cartes de prix. Les talons ont
   la même largeur, leurs pointillés s'alignent d'un coupon à l'autre.
   ===================================================================== */
const {
  amorce = 'Il reste des places pour la saison.',
} = Astro.props;

const formules = VEDETTES;
const code = [3, 1, 2, 1, 4, 1, 2, 3, 1, 2, 1, 3, 2, 1];
---

<section class="piege" aria-label="Carte d’accès : formule étudiante et formule adulte">
  <div class="contenu">
    <p class="amorce" data-revele>{amorce}</p>

    <div class="licence" data-revele data-delai="1">

      {/* le guilloché : le moiré des documents officiels */}
      <span class="licence__guilloche" aria-hidden="true"></span>

      {/* la bande d'en-tête, comme sur une carte d'accès */}
      <p class="licence__bandeau">
        <span class="licence__sigle" aria-hidden="true">BCP</span>
        <span class="licence__emetteur">Boxing Center Portet · Abonnement salle · Sans engagement</span>
      </p>

      <ul class="licence__coupons" role="list">
        {formules.map((o, i) => (
          <li class="licence__coupon">
            <a class="licence__lien" href={o.lien} rel="noopener"
               aria-label={`${o.activite}, sans engagement : ${o.prixTexte} ${o.duree}${o.condition ? `, ${o.condition}` : ''}. Offre externe à l’association, vendue par Boxing Center Portet.`}>
              <span class="licence__gauche">
                <span class="licence__formule">{o.court}</span>
                <span class="licence__prix" aria-hidden="true">
                  <b>{o.entier}</b><i>€{o.cents}</i>
                </span>
                <span class="licence__det">
                  <span>{o.duree}</span>
                  <span class="licence__condition">{o.condition}</span>
                </span>
              </span>

              <span class="licence__talon" aria-hidden="true">
                <span class="licence__action">Prendre<br />ma place
                  <svg width="13" height="10" viewBox="0 0 13 10" aria-hidden="true" focusable="false">
                    <path d="M8 1l4 4-4 4M12 5H0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="licence__serie">Formule {String(i + 1).padStart(2, '0')}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="licence__pied">
        <span class="licence__sur"><span>Offre externe à l’association ·</span> <span>Accès partagé ·</span> <span>Vendue par BCP</span></span>
        {/* le code-barres : quatorze traits, largeurs irrégulières */}
        <span class="licence__code" aria-hidden="true">
          {code.map((w) => (
            <i style={`--w:${w}px`}></i>
          ))}
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .piege { padding-block: clamp(2.4rem, 6vw, 4rem); }

  .amorce {
    margin: 0 0 1.3rem; max-width: 46ch;
    font-family: var(--f-affiche); text-transform: uppercase;
    font-size: clamp(1.1rem, 3.6vw, 1.8rem); line-height: 1.1;
    color: #F0C94E; text-shadow: 0 0 20px rgba(232, 192, 74, .3);
  }
  .amorce::before {
    content: ''; display: inline-block; width: 1.8em; height: 2px;
    margin-right: .7em; vertical-align: .28em; background: currentColor; opacity: .55;
  }

  /* ---------------------------------------------------- LA LICENCE --- */
  .licence {
    --talon: 8.4rem;
    --encre: #17110A;
    --perfo: rgba(23, 17, 10, .34);
    position: relative; isolation: isolate; overflow: hidden;
    display: block; max-width: 38rem;
    background: linear-gradient(142deg, #F2D071 0%, #E8C04A 38%, #D9A441 78%, #C79430 100%);
    color: var(--encre); border-radius: 8px;
    box-shadow: 0 22px 50px -24px rgba(232, 192, 74, .5), 0 2px 0 rgba(255, 255, 255, .35) inset;
    transform: rotate(-.5deg);
    transition: transform .35s var(--courbe), box-shadow .35s;
  }
  .licence:hover {
    transform: rotate(0deg) translateY(-4px) scale(1.012);
    box-shadow: 0 30px 64px -22px rgba(232, 192, 74, .68), 0 2px 0 rgba(255,255,255,.45) inset;
  }

  /* le moiré : deux trames croisées, très basses en opacité */
  .licence__guilloche {
    position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: .3;
    background:
      repeating-linear-gradient(58deg, rgba(23,17,10,.16) 0 1px, transparent 1px 7px),
      repeating-linear-gradient(-58deg, rgba(23,17,10,.13) 0 1px, transparent 1px 9px),
      repeating-radial-gradient(circle at 82% 22%, rgba(23,17,10,.12) 0 1px, transparent 1px 12px);
  }

  .licence__bandeau {
    position: relative; z-index: 1; margin: 0; max-width: none;
    display: flex; align-items: center; gap: .7rem;
    padding: .55rem clamp(1rem, 3vw, 1.5rem);
    background: rgba(23, 17, 10, .9); color: #F2D071;
    border-bottom: 1px solid rgba(23, 17, 10, .35);
  }
  .licence__sigle {
    display: grid; place-items: center; flex: none; width: 31px; aspect-ratio: 1;
    border: 1px solid currentColor; border-radius: 50%;
    font-family: var(--f-affiche); font-size: .68rem; letter-spacing: .04em;
  }
  .licence__emetteur {
    font-family: var(--f-mono); font-size: .58rem; letter-spacing: .2em;
    text-transform: uppercase; opacity: .92;
  }

  /* --- les deux coupons --- */
  .licence__coupons { position: relative; z-index: 1; list-style: none; margin: 0; padding: 0; }
  .licence__coupon { position: relative; }

  /* la perforation entre les coupons : un pointillé, et deux encoches
     creusées dans les bords, là où l'on plierait pour détacher */
  .licence__coupon + .licence__coupon { border-top: 2px dashed var(--perfo); }
  .licence__coupon + .licence__coupon::before,
  .licence__coupon + .licence__coupon::after {
    content: ''; position: absolute; top: -9px; z-index: 2;
    width: 16px; height: 16px; border-radius: 50%; background: var(--nuit);
  }
  .licence__coupon + .licence__coupon::before { left: -8px; }
  .licence__coupon + .licence__coupon::after { right: -8px; }

  .licence__lien {
    display: grid; grid-template-columns: minmax(0, 1fr) var(--talon); align-items: stretch;
    color: inherit; text-decoration: none;
    transition: background-color .3s var(--courbe);
  }
  .licence__lien:hover { background-color: rgba(255, 246, 214, .2); }
  .licence__lien:focus-visible { outline: 2px solid var(--encre); outline-offset: -5px; border-radius: 4px; }

  .licence__gauche {
    padding: 1rem clamp(1rem, 3vw, 1.5rem) 1.05rem clamp(1.2rem, 3.5vw, 1.8rem);
    display: grid; align-content: center; align-items: end;
    grid-template-columns: auto minmax(0, 1fr); column-gap: clamp(.9rem, 2.6vw, 1.5rem);
    grid-template-areas: 'formule formule' 'prix det';
  }
  .licence__formule {
    grid-area: formule;
    font-family: var(--f-affiche); text-transform: uppercase;
    font-size: clamp(.95rem, 2.6vw, 1.15rem); letter-spacing: .07em; line-height: 1;
  }
  .licence__prix { grid-area: prix; display: flex; align-items: flex-start; line-height: .8; margin: .3rem 0 0; }
  .licence__prix b { font-family: var(--f-affiche); font-weight: 400; font-size: clamp(3.3rem, 11vw, 4.8rem); letter-spacing: -.035em; }
  .licence__prix i {
    font-style: normal; font-family: var(--f-affiche);
    font-size: clamp(1.15rem, 3.6vw, 1.75rem); letter-spacing: -.01em;
    margin: .26em 0 0 .04em;
  }
  .licence__det {
    grid-area: det; display: grid; gap: .1rem; padding-bottom: .2rem;
    font-size: .76rem; font-weight: 600; line-height: 1.25; opacity: .78;
  }
  .licence__condition { font-weight: 700; opacity: .96; }

  /* le talon : même largeur sur les deux coupons, les pointillés s'alignent */
  .licence__talon {
    position: relative; display: grid; align-content: center; justify-items: center;
    gap: .45rem; padding: .9rem .8rem;
    border-left: 2px dashed var(--perfo);
    transition: background-color .3s var(--courbe);
  }
  .licence__lien:hover .licence__talon { background-color: rgba(23, 17, 10, .07); }
  .licence__action {
    font-family: var(--f-affiche); text-transform: uppercase;
    font-size: 1.05rem; line-height: .95; text-align: center;
    display: grid; justify-items: center; gap: .35rem;
  }
  .licence__action svg { transition: transform .3s var(--courbe); }
  .licence__lien:hover .licence__action svg,
  .licence__lien:focus-visible .licence__action svg { transform: translateX(4px); }
  .licence__serie {
    font-family: var(--f-mono); font-size: .5rem; letter-spacing: .1em;
    text-transform: uppercase; opacity: .5; white-space: nowrap;
  }

  /* --- le pied : le vendeur, et le code-barres --- */
  .licence__pied {
    position: relative; z-index: 1; margin: 0; max-width: none;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: .6rem clamp(1rem, 3vw, 1.5rem) .65rem clamp(1.2rem, 3.5vw, 1.8rem);
    border-top: 1px solid rgba(23, 17, 10, .22);
  }
  .licence__sur {
    font-family: var(--f-mono); font-size: .6rem; letter-spacing: .2em; line-height: 1.5;
    text-transform: uppercase; opacity: .66;
  }
  .licence__sur > span { white-space: nowrap; }
  .licence__code { flex: none; display: flex; align-items: flex-end; gap: 2px; height: 18px; opacity: .5; }
  .licence__code i { width: var(--w); height: 100%; background: var(--encre); border-radius: .5px; }

  .section--clair .licence__coupon + .licence__coupon::before,
  .section--clair .licence__coupon + .licence__coupon::after { background: var(--charbon); }

  @media (max-width: 560px) {
    .licence { --talon: 6.6rem; max-width: 100%; transform: none; }
    .licence:hover { transform: translateY(-3px); }
    .licence__action { font-size: .92rem; }
    .licence__talon { padding-inline: .5rem; }
  }
  /* Sous 380 px, le détail passe sous le prix plutôt que de s'écraser à côté. */
  @media (max-width: 379px) {
    .licence { --talon: 5.9rem; }
    .licence__gauche { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'formule' 'prix' 'det'; }
    .licence__det { padding: .45rem 0 0; }
    .licence__code { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .amorce { text-shadow: none; }
    .licence, .licence:hover, .licence__action svg { transition: none; transform: rotate(-.5deg); }
    .licence__lien:hover .licence__action svg { transform: none; }
  }
</style>
