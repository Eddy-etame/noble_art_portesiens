---
import { PESEE } from '../data/activites.js';

/* LE +1 DU PROJET. Voir .research/05-veille/contrat-fusion.md.

   Zéro JavaScript. Sur mobile la table se replie en trois fiches
   empilées via des étiquettes portées par CSS — pas une version
   amputée : les mêmes lignes, la même information, le même choix. */
---

<section class="section pesee-bloc" aria-labelledby="pesee-titre">
  <div class="fond-sec" style="--img:url(/img/opt/club-boxe-toulouse-portet-1200.webp)"></div>
  <span class="mot-fond" aria-hidden="true">Pesée</span>
  <div class="contenu">
    <p class="surtitre" data-revele>Trouver la sienne</p>
    <h2 id="pesee-titre" data-revele>Le tableau de la <span class="accent">pesée</span></h2>
    <p class="chapeau" data-revele>
      Avant un combat, on aligne les adversaires sur les mêmes lignes pour
      pouvoir les comparer d’un regard. On a fait pareil avec nos trois boxes.
    </p>

    <p class="pesee__guide micro" aria-hidden="true">
      Glissez pour comparer <span>·</span> <b data-pesee-index>1 / 3</b>
    </p>

    <div class="pesee__cadre" data-revele data-pesee-cadre>
      <table class="pesee">
        <caption class="visuellement-cache">
          Comparaison des trois activités du club : public, objectif, intensité,
          compétition, créneaux et tarif.
        </caption>
        <thead>
          <tr>
            <th scope="col"><span class="visuellement-cache">Critère</span></th>
            {PESEE.colonnes.map((c) => (
              <th scope="col" class="pesee__tete">
                <a href={`/${c.slug}/`}>{c.nom}</a>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {PESEE.lignes.map((l) => (
            <tr>
              <th scope="row" class="pesee__critere micro">{l.libelle}</th>
              {PESEE.colonnes.map((c) => (
                <td class="pesee__case" data-activite={c.nom}>
                  {l.cle === 'intensite' ? (
                    <span class="jauge" role="img"
                          aria-label={`Intensité ${c.intensite} sur 3`}>
                      {[1, 2, 3].map((n) => (
                        <i class:list={['jauge__cran', n <= c.intensite && 'jauge__cran--plein']}></i>
                      ))}
                    </span>
                  ) : (
                    <span class:list={[l.cle === 'tarif' && 'tabulaire']}>{c[l.cle]}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
          <tr>
            <td></td>
            {PESEE.colonnes.map((c) => (
              <td class="pesee__case pesee__case--action">
                <a class="btn btn--or pesee__btn" href={`/${c.slug}/`}>
                  <span>C’est la mienne</span><svg class="btn__fleche" width="13" height="10" viewBox="0 0 13 10" aria-hidden="true" focusable="false"><path d="M8 1l4 4-4 4M12 5H0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .pesee-bloc { position: relative; isolation: isolate; overflow: hidden; }
  .pesee__cadre { margin-top: var(--e4); overflow-x: auto; }
  .pesee__guide { display: none; }
  .pesee {
    width: 100%; min-width: 620px; border-collapse: collapse;
    text-align: left;
  }
  .pesee th, .pesee td {
    padding: var(--e2) var(--e3);
    border: 1px solid var(--trait-sourd);
    vertical-align: middle;
  }
  .pesee thead th { border-top: 0; }
  .pesee thead th:first-child, .pesee tbody tr:last-child td:first-child {
    border-inline-start: 0; border-block-start: 0;
  }
  .pesee__tete {
    position: relative;
    font-size: var(--t-l); font-weight: 900; letter-spacing: -.02em;
    text-transform: uppercase; background: var(--nuit);
  }
  .pesee__tete::before, .pesee__tete::after {
    content: ''; position: absolute; top: -1px; width: 9px; height: 9px;
    border-top: 1px solid var(--or);
  }
  .pesee__tete::before { left: -1px; border-left: 1px solid var(--or); }
  .pesee__tete::after { right: -1px; border-right: 1px solid var(--or); }
  .pesee__tete a { color: var(--craie); text-decoration: none; }
  .pesee__tete a:hover { color: var(--or); }
  .pesee__critere {
    width: 1%; white-space: nowrap; font-weight: 600;
    background: var(--nuit);
  }
  .pesee__case { font-size: var(--t-s); color: var(--craie-sourde); }
  .pesee tbody tr:hover .pesee__case { color: var(--craie); }
  .pesee__case--action { padding-block: var(--e3); }
  .pesee__btn { width: 100%; }

  /* La jauge d'intensité : trois crans, pas une note inventée sur 10. */
  .jauge { display: inline-flex; gap: 5px; }
  .jauge__cran {
    width: 22px; height: 6px; border-radius: 1px;
    background: var(--trait-sourd);
  }
  .jauge__cran--plein { background: var(--or); }

  /* --- TÉLÉPHONE : le MÊME tableau, qu'on fait défiler du pouce.
         Je l'avais replié en cartes par critère : ça changeait l'objet
         (on ne comparait plus, on lisait des fiches) et ça coûtait
         2 020 px de hauteur. Le tableau qui défile est plus fidèle au
         bureau et trois fois plus court. La première colonne reste
         collée pour qu'on sache toujours quelle ligne on lit. --- */
  @media (max-width: 760px) {
    .pesee__guide {
      margin: var(--e3) 0 calc(var(--e4) * -1 + .7rem);
      display: flex; align-items: center; gap: .45rem; color: var(--craie-sourde);
    }
    .pesee__guide b { color: var(--or); font-weight: 700; }
    .pesee__cadre {
      overflow-x: auto; scroll-snap-type: x proximity;
      margin-inline: -1.25rem; padding-inline: 1.25rem;
      overscroll-behavior-x: contain;
    }
    .pesee { min-width: 560px; }
    .pesee th, .pesee td { padding: .7rem .9rem; }
    .pesee__tete { font-size: var(--t-m); scroll-snap-align: start; }
    .pesee__critere {
      position: sticky; left: 0; z-index: 2;
      background: var(--nuit); font-size: 10px; white-space: normal;
      min-width: 5.5rem;
    }
    .pesee__case { font-size: var(--t-xs); }
    .jauge__cran { width: 14px; }
    .pesee__btn { font-size: 10px; padding: .7rem .5rem; }
  }
</style>

<script is:inline>
  (function () {
    var cadre = document.querySelector('[data-pesee-cadre]');
    var index = document.querySelector('[data-pesee-index]');
    if (!cadre || !index) return;
    var prev = 0;
    function synchroniser() {
      var max = Math.max(1, cadre.scrollWidth - cadre.clientWidth);
      var position = Math.min(2, Math.max(0, Math.round((cadre.scrollLeft / max) * 2)));
      if (position !== prev) {
        prev = position;
        index.textContent = String(position + 1) + ' / 3';
      }
    }
    cadre.addEventListener('scroll', synchroniser, { passive: true });
    addEventListener('resize', synchroniser, { passive: true });
  })();
</script>
