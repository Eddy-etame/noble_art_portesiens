---
import { NAV } from '../data/activites.js';
import { PLANNING, OFFRES } from '../data/club.js';
const annee = OFFRES.find((o) => o.vedette) || OFFRES[0];
const { chemin } = Astro.props;
const actif = (h) => h && (h === '/' ? chemin === '/' : chemin.startsWith(h));

/* =====================================================================
   L'EN-TÊTE — refait.

   AVANT : barre pleine floutée, logo à 84 px, cinq liens en 15 px, et
   une pastille orange pleine à droite. C'est le gabarit d'en-tête que
   porte la moitié du web depuis 2012.

   Relevé sur les quatorze en-têtes de la banque (darkroom.engineering,
   obys, igloo, zentry, basement, exoape, locomotive, antinomy,
   studiofreight, field.io, universaleverything) :
   · AUCUN n'a de barre pleine — la navigation flotte sur le contenu ;
   · le corps de texte y est à 10-12 px, pas 15 ;
   · AUCUN n'a de bouton plein dans la navigation ;
   · darkroom compose la sienne en petites boîtes filetées, en monospace,
     avec un indicateur d'état à l'extrémité.

   Contextualisation : des boîtes filetées avec un état en direct, dans
   une salle de sport, ce n'est pas un emprunt à un studio de design —
   c'est un tableau d'affichage. Il indique ici si le club est en cours
   d'entraînement, calculé sur le planning.
   ===================================================================== */
const creneaux = PLANNING.flatMap((c) =>
  c.creneaux.map((cr) => ({ nom: cr.activite || c.nom, jours: cr.jours, debut: cr.debut, fin: cr.fin })),
);
---

<header class="hud">
  <a class="hud__marque" href="/" aria-label="Noble Art Portésien — accueil">
    <img src="/img/opt/logo-128.webp"
         srcset="/img/opt/logo-64.webp 64w, /img/opt/logo-128.webp 128w" sizes="46px"
         alt="Noble Art Portésien, club de boxe anglaise à Portet-sur-Garonne"
         width="128" height="85" fetchpriority="high" decoding="async" />
  </a>

  <button class="hud__bascule" type="button" aria-expanded="false" aria-controls="nav-principale">
    <span class="hud__traits" aria-hidden="true"><i></i><i></i></span>
    <span class="visuellement-cache">Ouvrir le menu</span>
  </button>

  <nav id="nav-principale" class="hud__nav" aria-label="Navigation principale">
    <ul class="hud__liste">
      {NAV.map((item) => (
        <li class={item.enfants ? 'hud__item hud__item--groupe' : 'hud__item'}>
          {item.enfants ? (
            <>
              <button type="button" class="case case--parent" aria-expanded="false">
                {item.texte}
                <span class="case__plus" aria-hidden="true"></span>
              </button>
              <ul class="hud__sous">
                {item.enfants.map((e) => (
                  <li>
                    <a href={e.href} class="case case--sous"
                       aria-current={actif(e.href) ? 'page' : undefined}>{e.texte}</a>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <a href={item.href}
               class={item.cta ? 'case case--cta' : 'case'}
               aria-current={actif(item.href) ? 'page' : undefined}
               target={item.externe ? '_blank' : undefined}
               rel={item.externe ? 'noopener' : undefined}>
              {item.texte}{item.externe && <span class="visuellement-cache"> (nouvelle fenêtre)</span>}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>

  {/* LE GROUPE DE DROITE. L'offre et le reperage geographique ne sont
      pas des entrees de menu : ils etaient collés aux liens de navigation
      comme s'ils en faisaient partie. Ils forment maintenant un bloc
      separe, pousse a droite, avec un filet vertical qui marque la
      coupure. */}
  <div class="hud__droite">
  {/* L'OFFRE, EN PERMANENCE DANS LA BARRE.
      Elle était en bas de page : on pouvait descendre quinze écrans sans
      croiser un prix. Elle est maintenant toujours là, en or, avec le
      prix barré dedans — motif repris de votre `.btn--saison`. */}
  <a class="offre-barre" href={annee.lien} rel="noopener"
     aria-label={`L’année complète à ${annee.prix} € au lieu de ${annee.prixBarre} € — voir l’offre`}>
    <span class="offre-barre__corps">
      <span class="offre-barre__l" aria-hidden="true">L’année · 26/27</span>
      <span class="offre-barre__p" aria-hidden="true">
        {annee.prix}<em>€</em><s>{annee.prixBarre}€</s>
      </span>
    </span>
    {/* le talon perforé : même objet que la licence et la plaque,
        réduit à sa plus simple expression */}
    <span class="offre-barre__talon" aria-hidden="true"></span>
    <span class="offre-barre__reflet" aria-hidden="true"></span>
  </a>

  {/* L'indicateur d'état : la salle tourne-t-elle en ce moment ?
      Calculé sur le planning, à l'heure du visiteur. */}
  <p class="case case--etat" data-etat aria-live="polite">
    <span class="pastille" aria-hidden="true"></span><span data-etat-txt>Portet · 31120</span>
  </p>
  </div>
</header>

<style>
  /* Pas de barre. La navigation flotte SUR le contenu. */
  .hud {
    position: fixed; inset-inline: 0; top: 0; z-index: 60;
    display: flex; align-items: center; gap: .55rem;
    padding: .8rem clamp(.8rem, 2.4vw, 1.6rem);
    background: transparent;
    transition: background-color .35s var(--courbe), backdrop-filter .35s;
  }
  .hud::after {
    content: ''; position: absolute; inset: auto 0 -5px; height: 5px;
    opacity: 0; pointer-events: none;
    background:
      linear-gradient(rgba(255,128,36,.62), rgba(255,128,36,.62)) 0 0 / 100% 1px no-repeat,
      linear-gradient(rgba(250,250,250,.16), rgba(250,250,250,.16)) 0 2px / 100% 1px no-repeat,
      linear-gradient(rgba(255,128,36,.28), rgba(255,128,36,.28)) 0 4px / 100% 1px no-repeat;
    transition: opacity .25s;
  }
  /* Elle ne s'opacifie qu'une fois qu'on a quitté le héros. */
  .hud.pose {
    background: color-mix(in srgb, var(--nuit) 82%, transparent);
    backdrop-filter: blur(16px) saturate(1.2);
  }
  .hud.pose::after { opacity: 1; }

  .hud__marque { flex: none; display: block; line-height: 0; }
  .hud__marque img { width: 46px; height: auto; }

  /* La boîte filetée : l'unité de base du tableau d'affichage. */
  /* Les cases etaient a 10 px sur un filet a 22 % d'opacite : lisibles
     sur une capture, pas sur un ecran en plein jour. On monte le corps,
     on renforce le filet, on pose un fond tres leger qui les detache de
     l'image. */
  .case {
    display: inline-flex; align-items: center; gap: .45rem;
    font-family: var(--f-mono); font-size: 11px; font-weight: 500;
    letter-spacing: .13em; text-transform: uppercase;
    color: var(--craie); text-decoration: none;
    background: rgba(20, 20, 20, .42);
    border: 1px solid rgba(250, 250, 250, .34);
    border-radius: 2px; padding: .6rem .8rem; cursor: pointer; min-height: 44px;
    white-space: nowrap;
    transition: border-color .25s, color .25s, background-color .25s;
  }
  .case:hover { border-color: var(--or); color: var(--or); }
  .case[aria-current='page'] { border-color: var(--or); color: var(--or); }
  .case--cta { border-color: var(--or); color: var(--or); }
  .case--cta:hover { background: var(--or); color: var(--charbon); }
  .case--etat { margin: 0; }

  /* le groupe de droite, detache par un filet vertical */
  .hud__droite {
    margin-left: auto; flex: none;
    display: flex; align-items: center; gap: .5rem;
    padding-left: clamp(.7rem, 1.6vw, 1.2rem);
    border-left: 1px solid rgba(250, 250, 250, .2);
  }

  /* --- l'offre dans la barre ---
     Elle appartient à la même famille que la licence et la plaque : de
     l'or, un guilloché, un talon perforé et un reflet. Trois objets, un
     seul langage — c'est ce qui fait qu'on les reconnaît. */
  .offre-barre {
    position: relative; overflow: hidden; flex: none; margin: 0;
    display: inline-grid; grid-template-columns: auto auto; align-items: stretch;
    border-radius: 4px; text-decoration: none; min-height: 44px;
    background: linear-gradient(142deg, #F2D071, #E8C04A 46%, #D9A441);
    color: #17110A;
    box-shadow: 0 6px 18px -8px rgba(232, 192, 74, .55), 0 1px 0 rgba(255,255,255,.42) inset;
    transition: transform .25s var(--courbe), box-shadow .3s;
  }
  .offre-barre::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: .26;
    background:
      repeating-linear-gradient(58deg, rgba(23,17,10,.18) 0 1px, transparent 1px 6px),
      repeating-linear-gradient(-58deg, rgba(23,17,10,.14) 0 1px, transparent 1px 8px);
  }
  .offre-barre:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 24px -8px rgba(232, 192, 74, .72), 0 1px 0 rgba(255,255,255,.5) inset;
  }
  .offre-barre__corps {
    position: relative; z-index: 1; display: grid; gap: .02rem;
    padding: .38rem .7rem .4rem .78rem; align-content: center;
  }
  .offre-barre__l {
    font-family: var(--f-mono); font-size: 8.5px; letter-spacing: .18em;
    text-transform: uppercase; opacity: .66; white-space: nowrap;
  }
  .offre-barre__p {
    font-family: var(--f-affiche); font-size: 1.22rem; line-height: .92;
    letter-spacing: -.02em; display: flex; align-items: baseline; gap: .1rem;
  }
  .offre-barre__p em { font-style: normal; font-size: .62em; }
  .offre-barre__p s {
    font-family: var(--f-mono); font-size: .55rem; margin-left: .4rem;
    opacity: .5; text-decoration-thickness: 1.5px;
  }
  /* le talon : un filet pointillé et deux encoches creusées */
  .offre-barre__talon {
    position: relative; z-index: 1; width: 12px;
    border-left: 2px dashed rgba(23, 17, 10, .32);
  }
  .offre-barre__talon::before, .offre-barre__talon::after {
    content: ''; position: absolute; left: -7px; width: 12px; height: 12px;
    border-radius: 50%; background: var(--nuit);
  }
  .offre-barre__talon::before { top: -7px; }
  .offre-barre__talon::after { bottom: -7px; }
  .offre-barre__reflet {
    position: absolute; inset: 0; pointer-events: none; z-index: 2;
    background: linear-gradient(105deg, transparent 34%, rgba(255,255,255,.5) 50%, transparent 66%);
    transform: translateX(-130%);
  }
  .offre-barre:hover .offre-barre__reflet { transition: transform 1s var(--courbe); transform: translateX(130%); }

  /* Sous 420 px : le libellé et le prix barré tombent, l'or et le chiffre
     restent. Un chiffre en or à côté du sigle n'a pas besoin d'être expliqué. */
  @media (max-width: 420px) {
    .offre-barre__l, .offre-barre__p s { display: none; }
    .offre-barre__corps { padding: .38rem .55rem .4rem .6rem; }
    .offre-barre__p { font-size: 1.1rem; }
    .offre-barre__talon { width: 9px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .offre-barre, .offre-barre:hover { transition: none; transform: none; }
    .offre-barre__reflet { display: none; }
  }

  .pastille {
    width: 6px; height: 6px; border-radius: 50%;
    background: rgba(250, 250, 250, .4); flex: none;
  }
  .case--etat.ouvert { border-color: var(--or); color: var(--or); }
  .case--etat.ouvert .pastille { background: var(--or); animation: pouls 2s ease-in-out infinite; }
  @keyframes pouls { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

  .case__plus { position: relative; width: 7px; height: 7px; flex: none; }
  .case__plus::before, .case__plus::after {
    content: ''; position: absolute; inset: 50% 0 auto 0; height: 1px; background: currentColor;
  }
  .case__plus::after { transform: rotate(90deg); transition: transform .25s var(--courbe); }
  [aria-expanded='true'] .case__plus::after { transform: rotate(0); }

  .hud__liste { list-style: none; margin: 0; padding: 0; display: flex; gap: .35rem; }
  .hud__item { position: relative; }
  .hud__sous {
    position: absolute; top: calc(100% + .35rem); left: 0;
    list-style: none; margin: 0; padding: .35rem;
    display: grid; gap: .25rem; min-width: 13rem;
    background: color-mix(in srgb, var(--nuit) 94%, transparent);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(250, 250, 250, .22); border-radius: 2px;
    opacity: 0; visibility: hidden; transform: translateY(-5px);
    transition: opacity .2s, transform .2s var(--courbe), visibility .2s;
  }
  .hud__sous .case--sous { width: 100%; border-color: transparent; }
  .hud__item--groupe:hover .hud__sous,
  .hud__item--groupe:focus-within .hud__sous,
  .hud__item--groupe.deplie .hud__sous { opacity: 1; visibility: visible; transform: none; }

  .hud__bascule {
    display: none; width: 44px; height: 44px;
    background: none; border: 1px solid rgba(250, 250, 250, .22);
    border-radius: 2px; color: var(--craie); cursor: pointer;
    place-items: center;
  }
  .hud__traits { display: grid; gap: 5px; width: 16px; }
  .hud__traits i { display: block; height: 1px; background: currentColor; transition: transform .3s var(--courbe); }
  .hud__bascule[aria-expanded='true'] i:nth-child(1) { transform: translateY(3px) rotate(45deg); }
  .hud__bascule[aria-expanded='true'] i:nth-child(2) { transform: translateY(-3px) rotate(-45deg); }

  /* --- TÉLÉPHONE : les mêmes boîtes, dépliées sous l'en-tête.
         Pas un menu d'un autre type : le même tableau d'affichage. --- */
  @media (max-width: 1339px) {
    /* Le hamburger et l'offre forment un seul groupe à droite. Chacun
       portait `margin-left:auto` : le premier partait au milieu, le
       second au bord, et l'écart entre les deux n'avait aucun sens. */
    .hud__bascule { display: grid; order: 3; margin-left: .1rem; }
    .hud__droite { order: 2; margin-left: auto; padding-left: 0; border-left: 0; gap: .4rem; }
    .case--etat { display: none; }

    /* Le panneau tombe en `top: 100%` : il est donc HORS de la boîte peinte
       du HUD, et le fond de la barre ne le couvrait pas. Sans surface à lui,
       on lisait le planning au travers des liens. Il porte sa propre nuit. */
    .hud__nav {
      position: absolute; inset-inline: 0; top: 100%;
      padding: 0 clamp(.8rem, 2.4vw, 1.6rem);
      max-height: 0; overflow: hidden; visibility: hidden;
      background: color-mix(in srgb, var(--nuit) 97%, transparent);
      backdrop-filter: blur(18px) saturate(1.15);
      box-shadow: 0 26px 46px -22px rgba(0, 0, 0, .92);
      transition: max-height .4s var(--courbe), visibility 0s linear .4s;
    }
    .hud__nav.ouverte {
      max-height: 80vh; overflow-y: auto; overscroll-behavior: contain;
      padding-bottom: .9rem; visibility: visible;
      transition-delay: 0s;
    }

    /* Le voile ne peut pas vivre ici : `backdrop-filter` fait du HUD le bloc
       conteneur de ses enfants `fixed`, qui se retrouvent bornés à la barre
       (mesuré : 73 px au lieu de 780). Il est posé sur `body` dans global.css.

       Menu ouvert en haut de page : la barre doit être opaque elle aussi,
       sinon un bandeau transparent flotte au-dessus d'un panneau plein. */
    .hud.menu-ouvert {
      background: color-mix(in srgb, var(--nuit) 97%, transparent);
      backdrop-filter: blur(18px) saturate(1.15);
    }
    .hud.menu-ouvert::after { opacity: 1; }
    .hud__liste { flex-direction: column; gap: .3rem; }
    .case { width: 100%; justify-content: space-between; padding: .85rem .8rem; font-size: 11px; }
    .hud__sous {
      position: static; opacity: 1; visibility: hidden; transform: none;
      background: none; border: 0; backdrop-filter: none;
      max-height: 0; overflow: hidden; padding: 0; min-width: 0;
      transition: max-height .3s var(--courbe), visibility 0s linear .3s;
    }
    .hud__item--groupe.deplie .hud__sous {
      max-height: 22rem; padding: .3rem 0 .3rem .8rem; visibility: visible;
      transition-delay: 0s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hud, .hud__nav, .hud__sous, .case__plus::after, .pastille { transition: none; animation: none; }
  }
</style>

<style is:global>
  @media (max-width: 1339px) {
    html:not(.js) .hud { position: relative; flex-wrap: wrap; background: var(--nuit); }
    html:not(.js) .hud__bascule { display: none !important; }
    html:not(.js) .hud__nav {
      position: static; order: 3; width: 100%; max-height: none !important;
      padding: .5rem 0 0; overflow: visible; visibility: visible !important;
    }
    html:not(.js) .hud__liste { flex-direction: column; }
    html:not(.js) .hud__item--groupe > .case--parent { display: none; }
    html:not(.js) .hud__sous {
      position: static; opacity: 1; visibility: visible !important; transform: none;
      max-height: none !important; padding: 0 0 0 .8rem; background: none; border: 0;
    }
  }
</style>

<script is:inline define:vars={{ creneaux }}>
  (function () {
    var hud = document.querySelector('.hud');
    var bascule = document.querySelector('.hud__bascule');
    var nav = document.getElementById('nav-principale');

    // L'en-tête ne s'opacifie qu'après le héros : sur l'écran d'accueil
    // elle flotte sur l'image, comme chez igloo et zentry.
    function poser() { hud.classList.toggle('pose', window.scrollY > 60); }
    poser(); addEventListener('scroll', poser, { passive: true });

    /* Un seul endroit décide de l'état du menu : la barre, le voile, le
       verrou de défilement et la plaque flottante en dépendent tous. */
    function basculerMenu(ouvrir) {
      if (!bascule || !nav) return;
      bascule.setAttribute('aria-expanded', String(ouvrir));
      nav.classList.toggle('ouverte', ouvrir);
      hud.classList.toggle('menu-ouvert', ouvrir);
      document.body.classList.toggle('menu-ouvert', ouvrir);
      var libelle = bascule.querySelector('.visuellement-cache');
      if (libelle) libelle.textContent = ouvrir ? 'Fermer le menu' : 'Ouvrir le menu';
    }
    function menuOuvert() { return !!(nav && nav.classList.contains('ouverte')); }

    if (bascule && nav) {
      bascule.addEventListener('click', function () { basculerMenu(!menuOuvert()); });

      // Une ancre de la même page ne recharge rien : sans ceci, le menu
      // restait ouvert par-dessus la section qu'on venait de demander.
      nav.addEventListener('click', function (e) {
        if (e.target.closest('a')) basculerMenu(false);
      });

      // Cliquer à côté ferme, comme partout ailleurs. Le voile appartient à
      // `body`, donc l'écoute est au document, hors de l'en-tête.
      document.addEventListener('click', function (e) {
        if (menuOuvert() && !e.target.closest('.hud')) basculerMenu(false);
      });

      // Repassé en navigation large : l'état mobile n'a plus de sens.
      addEventListener('resize', function () {
        if (menuOuvert() && innerWidth > 1339) basculerMenu(false);
      }, { passive: true });
    }
    document.querySelectorAll('.case--parent').forEach(function (b) {
      b.addEventListener('click', function () {
        var it = b.closest('.hud__item--groupe');
        var o = b.getAttribute('aria-expanded') === 'true';
        b.setAttribute('aria-expanded', String(!o));
        it.classList.toggle('deplie', !o);
      });
    });
    addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var menuEtaitOuvert = menuOuvert();
      document.querySelectorAll('.case--parent[aria-expanded="true"]').forEach(function (b) {
        b.setAttribute('aria-expanded', 'false');
        var it = b.closest('.hud__item--groupe');
        if (it) it.classList.remove('deplie');
      });
      basculerMenu(false);
      if (menuEtaitOuvert && bascule) bascule.focus();
    });

    // Le tableau d'affichage : la salle tourne-t-elle en ce moment ?
    var boite = document.querySelector('[data-etat]');
    var txt = document.querySelector('[data-etat-txt]');
    if (boite && txt) {
      function min(s) { var p = s.split(':'); return +p[0] * 60 + +p[1]; }
      function etat() {
        var CODE = { Mon: 'Mo', Tue: 'Tu', Wed: 'We', Thu: 'Th', Fri: 'Fr', Sat: 'Sa', Sun: 'Su' };
        var parties = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/Paris', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
        }).formatToParts(new Date());
        var valeurs = {};
        parties.forEach(function (p) { valeurs[p.type] = p.value; });
        var j = CODE[valeurs.weekday], m = Number(valeurs.hour) * 60 + Number(valeurs.minute);
        var e = creneaux.find(function (c) {
          return c.jours.indexOf(j) !== -1 && m >= min(c.debut) && m < min(c.fin);
        });
        var suivant = e ? e.nom + ' en cours' : 'Portet · 31120';
        boite.classList.toggle('ouvert', !!e);
        if (txt.textContent !== suivant) txt.textContent = suivant;
      }
      etat(); setInterval(etat, 60000);
    }
  })();
</script>
