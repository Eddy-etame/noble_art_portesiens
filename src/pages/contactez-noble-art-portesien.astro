---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import Pesee from '../components/Pesee.astro';
import PlanningBloc from '../components/Planning.astro';
import Offres from '../components/Offres.astro';
import Salle from '../components/Salle.astro';
import Piege from '../components/Piege.astro';
import Questions from '../components/Questions.astro';

/* « Contact » et « Rejoindre le club » n'etaient pas modelisees comme deux
   intentions differentes sur l'ancien site : une seule page melangeait
   l'inclusion, les activites, les tarifs, le formulaire et la carte.
   Ici la page assume son role — c'est la page d'adhesion — et le
   formulaire arrive en tete, pas apres 4 000 px de defilement. */
---

<Base
  titre="S’inscrire au club de boxe de Portet-sur-Garonne (31120)"
  description="Rejoignez le Noble Art Portésien, club de boxe anglaise à Portet-sur-Garonne près de Toulouse : horaires, tarifs, essai. 61 route d’Espagne, 09 54 14 74 72."
  chemin="/contactez-noble-art-portesien/"
  image="/img/boxe-anglaise-nap-toulouse-contact.webp"
  filDAriane={[{ texte: 'Accueil', href: '/' }, { texte: 'Nous rejoindre' }]}>

  <section class="tete">
    <img class="tete__fond" src="/img/boxe-anglaise-nap-toulouse-contact.webp"
         alt="" aria-hidden="true"
         width="1440" height="536" fetchpriority="high" decoding="async" />
    <div class="contenu tete__corps">
      <nav class="fil micro" aria-label="Fil d’Ariane">
        <a href="/">Accueil</a> <span aria-hidden="true">/</span> <span>Nous rejoindre</span>
      </nav>
      <h1 class="tete__titre">La Boxe Comme Moteur d’Insertion et Inclusion</h1>
      <p class="tete__chapeau">
        Une question, une inscription, une visite : le club vous répond.
        Vous pouvez aussi passer directement aux heures d’entraînement.
      </p>
      <ul class="tete__raccourcis micro">
        <li><a href="#contact">Écrire au club</a></li>
        <li><a href="#planning">Voir les créneaux</a></li>
        <li><a href="#tarifs">Voir les tarifs</a></li>
      </ul>
    </div>
  </section>

  <Contact />
  <Pesee />
  <PlanningBloc />
  <Questions />
  <Piege amorce="Une séance d’essai, et vous saurez." />
  <Salle />
  <Offres />
</Base>

<style>
  .tete {
    position: relative; isolation: isolate; display: grid; align-content: end;
    min-height: min(58svh, 480px);
    padding-block: clamp(4.5rem, 11vw, 7rem) clamp(2.5rem, 6vw, 4rem); overflow: hidden;
  }
  .tete__fond { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .tete::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, var(--nuit) 8%, rgba(34,34,34,.88) 48%, rgba(34,34,34,.5) 100%);
  }
  .tete__corps { display: grid; gap: var(--e3); }
  .fil { display: flex; gap: .5rem; }
  .fil a { color: var(--craie-sourde); text-decoration: none; }
  .fil a:hover { color: var(--or); }
  .tete__titre { font-size: clamp(2rem, 5.6vw, 4.2rem); text-transform: uppercase; }
  .tete__chapeau { font-size: var(--t-m); color: var(--craie-sourde); max-width: 52ch; }
  .tete__raccourcis { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--e3); }
  .tete__raccourcis a { color: var(--or); text-decoration: none; }
  .tete__raccourcis a:hover { text-decoration: underline; }
</style>
