---
import Base from '../layouts/Base.astro';
import { CONFIDENTIALITE } from '../data/confidentialite.js';
const blocs = CONFIDENTIALITE.slice(1);
---
<Base
  titre="Politique de confidentialite - Noble Art Portesien"
  description="Politique de confidentialite du site du Noble Art Portesien : donnees collectees, cookies, droits des utilisateurs."
  chemin="/politique-de-confidentialite/"
  filDAriane={[{ texte: 'Accueil', href: '/' }, { texte: 'Politique de confidentialite' }]}>
  <article class="section juridique">
    <div class="contenu">
      <nav class="fil micro" aria-label="Fil d’Ariane">
        <a href="/">Accueil</a> <span aria-hidden="true">/</span> <span>Confidentialite</span>
      </nav>
      <h1>{CONFIDENTIALITE[0].c}</h1>
      {blocs.map((b) => (
        b.t.startsWith('h') ? <h2>{b.c}</h2> : b.t === 'li' ? <p class="puce">{b.c}</p> : <p>{b.c}</p>
      ))}
    </div>
  </article>
</Base>
<style>
  .juridique { padding-top: clamp(6rem, 14vw, 9rem); }
  .fil { display: flex; gap: .5rem; margin-bottom: var(--e2); }
  .fil a { color: var(--craie-sourde); text-decoration: none; }
  .juridique h1 { font-size: clamp(1.9rem, 4.6vw, 3.2rem); text-transform: uppercase; margin-bottom: var(--e4); }
  .juridique h2 {
    font-size: var(--t-l); margin-top: var(--e5); margin-bottom: var(--e2);
    padding-top: var(--e3); border-top: 1px solid var(--trait-sourd);
  }
  .juridique p { color: var(--craie-sourde); margin-bottom: var(--e2); }
  .puce { padding-left: var(--e2); border-left: 2px solid var(--trait-sourd); }
</style>
