---
import Base from '../layouts/Base.astro';
import Offres from '../components/Offres.astro';
import PlanningBloc from '../components/Planning.astro';
import Rejoindre from '../components/Rejoindre.astro';
import Pesee from '../components/Pesee.astro';
import Salle from '../components/Salle.astro';
import Piege from '../components/Piege.astro';
import Img from '../components/Img.astro';
import { ACTIVITES, INSERTION } from '../data/activites.js';

/* Les trois pages d'activité partagent une structure, pas un copier-coller.
   Sur l'ancien site elles étaient trois pages indépendantes dans lesquelles
   les mêmes blocs avaient été recollés à la main — d'où les tarifs Éducative
   affichés sur la page Loisir. */
export function getStaticPaths() {
  return ACTIVITES.map((a) => ({ params: { activite: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const resumesSource = {
  'boxe-amateur-toulouse-formation-competitive': 'La Boxe Amateur au Noble Art Portésien allie excellence sportive et développement personnel, offrant soutien et outils pour se surpasser.',
  'boxe-loisir-toulouse-detente-sportive': 'Notre programme de Boxe Loisir à Noble Art Portésien permet de découvrir la boxe sans compétition, dans une ambiance conviviale.',
  'boxe-educative-jeunes-toulouse': 'Découvrez la Boxe Éducative : chaque coup enseigne discipline, confiance et respect, transformant l’énergie des jeunes en excellence.',
};
const autres = [
  ...ACTIVITES
    .filter((x) => x.slug !== a.slug)
    .map((x) => ({ ...x, resume: resumesSource[x.slug] || x.resume })),
  {
    slug: INSERTION.slug,
    nom: 'Boxe Insertion',
    resume: 'Au Noble Art Portésien, nous utilisons la boxe comme vecteur d’intégration, offrant des programmes accessibles à tous pour promouvoir l’inclusion.',
    image: INSERTION.image,
    imageAlt: INSERTION.imageAlt,
  },
];
---

<Base
  titre={a.seo.title}
  description={a.seo.description}
  chemin={`/${a.slug}/`}
  image={`/img/${a.image}`}
  filDAriane={[{ texte: 'Accueil', href: '/' }, { texte: a.nom }]}>

  <section class="tete">
    <Img class="tete__fond" src={a.image} alt={a.imageAlt} width="1440" height="740"
         sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="contenu tete__corps">
      <nav class="fil micro" aria-label="Fil d’Ariane">
        <a href="/">Accueil</a> <span aria-hidden="true">/</span> <span>{a.nom}</span>
      </nav>
      <h1 class="tete__titre">{a.h1}</h1>
      <p class="tete__chapeau">{a.chapeau}</p>
      <div class="tete__actions">
        <a class="btn btn--or" href={`#${a.ancreActivites}`}><span>Nos activités</span><svg class="btn__fleche" width="13" height="10" viewBox="0 0 13 10" aria-hidden="true" focusable="false"><path d="M8 1l4 4-4 4M12 5H0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <a class="btn btn--fantome" href="#tarifs"><span>Nos offres</span><svg class="btn__fleche" width="13" height="10" viewBox="0 0 13 10" aria-hidden="true" focusable="false"><path d="M8 1l4 4-4 4M12 5H0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="prog-titre">
    <div class="contenu prog">
      <div class="prog__intro">
        <p class="surtitre" data-revele>{a.nom}</p>
        <h2 id="prog-titre" data-revele>{a.sectionTitre}</h2>
        <p data-revele>{a.sectionTexte}</p>
      </div>
      <Img class="prog__img" src={a.imageSecondaire} alt={a.imageSecondaireAlt}
           width="1440" height="580" sizes="(max-width: 939px) 100vw, 46vw" data-revele />
    </div>
  </section>

  <section class="section section--clair biais" aria-labelledby="piliers-titre">
    <span id={a.ancreActivites} class="ancre-heritee"></span>
    <div class="contenu">
      <h2 id="piliers-titre" class="visuellement-cache">Ce que comprend le programme</h2>
      <ol class="piliers">
        {a.piliers.map((p, i) => (
          <li class="pilier" data-revele data-delai={String(i % 2)}>
            <p class="pilier__num micro micro--or">Round {String(i + 1).padStart(2, '0')}</p>
            <h3 class="pilier__titre">{p.titre}</h3>
            <p class="pilier__texte">{p.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Pesee />
  <PlanningBloc />
  <Piege amorce={`La ${a.nom} vous attend cette saison.`} />
  <Salle />

  <Offres alias={a.ancres} />

  <section class="section" aria-labelledby="autres-titre">
    <div class="contenu">
      <p class="surtitre" data-revele>Les autres boxes</p>
      <h2 id="autres-titre" data-revele>Un engagement pour tous</h2>
      <div class="autres">
        {autres.map((o, i) => (
          <article class="autre" data-revele data-delai={String(i)}>
            <span class="autre__num tabulaire" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <Img src={o.image} alt={o.imageAlt} width="1440" height="740"
                 sizes="(max-width: 639px) 100vw, 45vw" />
            <div class="autre__corps">
              <h3><a class="lien-couvrant" href={`/${o.slug}/`}>{o.nom}</a></h3>
              <p>{o.resume}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Rejoindre image={`/img/${a.image}`} />
</Base>

<style>
  .tete {
    position: relative; isolation: isolate;
    display: grid; align-content: end;
    min-height: min(72svh, 640px);
    padding-block: clamp(5rem, 12vw, 8rem) clamp(3rem, 7vw, 5rem);
    overflow: hidden;
  }
  .tete__fond {
    position: absolute; inset: 0; z-index: -2;
    width: 100%; height: 100%; object-fit: cover;
  }
  .tete::after {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, var(--nuit) 6%, rgba(34,34,34,.86) 45%, rgba(34,34,34,.42) 100%);
  }
  .tete__corps { display: grid; gap: var(--e3); }
  .fil { display: flex; gap: .5rem; }
  .fil a { color: var(--craie-sourde); text-decoration: none; }
  .fil a:hover { color: var(--or); }
  .tete__titre { font-size: clamp(2.2rem, 6.6vw, 5rem); text-transform: uppercase; }
  .tete__chapeau { font-size: var(--t-m); color: var(--craie-sourde); max-width: 54ch; }
  .tete__actions { display: flex; flex-wrap: wrap; gap: var(--e2); }

  .prog { display: grid; gap: var(--e4); }
  @media (min-width: 940px) { .prog { grid-template-columns: 1.15fr 1fr; gap: var(--e6); align-items: start; } }
  .prog__intro { display: grid; gap: var(--e2); }
  .prog__img { border-radius: var(--rayon); width: 100%; object-fit: cover; }

  .piliers { list-style: none; margin: 0; padding: 0; border-block: 2px solid var(--or); }
  .pilier {
    padding: clamp(1.4rem, 3.5vw, 2.8rem) 0; display: grid; gap: .7rem;
    border-bottom: 1px solid var(--trait-sourd); align-items: start;
  }
  .pilier:last-child { border-bottom: 0; }
  @media (min-width: 860px) {
    .pilier { grid-template-columns: 7rem minmax(13rem, .72fr) minmax(0, 1.28fr); gap: var(--e4); }
    .pilier:nth-child(even) { margin-left: 8%; }
    .pilier:nth-child(odd) { margin-right: 8%; }
  }
  .pilier__num { margin: 0; }
  .pilier__titre { font-size: var(--t-m); }
  .pilier__texte { font-size: var(--t-s); color: var(--craie-sourde); }

  .autres { margin-top: var(--e4); display: grid; gap: 1px; background: var(--or); }
  @media (min-width: 900px) {
    .autres { grid-template-columns: 1.16fr .84fr; }
    .autre:nth-child(3) { grid-column: 1; }
  }
  .autre {
    position: relative; isolation: isolate; overflow: hidden; min-height: 420px;
    background: var(--nuit); display: grid; align-content: end;
  }
  .autre::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, var(--nuit), transparent 82%); }
  .autre img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; transition: transform .55s var(--courbe); }
  .autre__num { position: absolute; top: 1rem; right: 1rem; font-family: var(--f-affiche); font-size: 4rem; color: transparent; -webkit-text-stroke: 1px var(--or); }
  .autre__corps { padding: clamp(1.25rem, 3vw, 2.2rem); display: grid; gap: .5rem; }
  .autre__corps h3 a { color: var(--craie); text-decoration: none; }
  .autre__corps h3 a::after { content: ''; position: absolute; inset: 0; }
  .autre:hover .autre__corps h3 a { color: var(--or); }
  .autre__corps p { font-size: var(--t-s); color: var(--craie-sourde); }
  .autre:hover img { transform: scale(1.035); }
  @media (max-width: 899px) { .autre { min-height: 470px; } }
  @media (prefers-reduced-motion: reduce) { .autre:hover img { transform: none; } }
</style>
